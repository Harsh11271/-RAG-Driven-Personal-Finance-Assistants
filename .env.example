# ============================================================
# FINANCE ASSISTANT — Environment Configuration
# ============================================================

# --- LLM Provider ---
# Options: gemini | openai
LLM_PROVIDER=gemini

# --- API Keys (YOU MUST FILL THESE IN) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# --- Auth ---
JWT_SECRET=YOUR_JWT_SECRET_HERE

# --- MongoDB ---
MONGODB_URI=mongodb://mongo:27017/auth_db

# --- Pathway ---
DATA_DIR=/app/data/user-uploads
PATHWAY_URL=http://pathway-processor:8081

# --- Kafka (optional, currently using CSV fallback) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Plaid Integration ---
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox